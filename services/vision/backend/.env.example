# Copy this file to  backend/.env  (same folder as app.py) and edit it. All settings are optional.
# (run.py does this for you; real environment variables override the file.)
DEMO_MODE=0                 # 1 = simulated recognition, no camera or model
CAMERA_MODE=webcam          # webcam | rtsp | hikvision
CAMERA_IP=192.168.1.64
CAMERA_USER=admin
CAMERA_PASSWORD=change-me
CAMERA_URL=0                # webcam index, or rtsp://user:pass@ip:554/stream
USE_GPU=0                   # 1 = CUDA (needs onnxruntime-gpu)
RECOGNITION_THRESHOLD=0.5
LATE_AFTER_MIN=10
SCHEDULER=0                 # 1 = auto start/stop by TIMETABLE in app.py
RECORD_VIDEO=0
PTZ_ENABLED=0
PORT=5000

# ---------------- Smart ID Scan (ID-card enforcement) ----------------
ID_FINE_AMOUNT=50            # rupees added to the student's fee dues per confirmed violation
ID_AUTO_CONFIRM=0            # 0 = teacher reviews first (recommended) | 1 = fine automatically
ID_CONFIRM_HITS=3            # sightings without an ID before a violation is raised
ID_CONFIRM_WINDOW=20         # ...within this many seconds
ID_FACE_THRESHOLD=0.5        # face-match similarity needed to name the student
ID_PERSON_CONF=0.6
ID_CARD_CONF=0.3
ID_MODEL_PERSON=models/yolov8n.pt
ID_MODEL_CARD=models/my_model.pt
ID_CAMERA_MODE=              # leave empty to reuse CAMERA_MODE / CAMERA_URL (webcam | rtsp | hikvision)
ID_CAMERA_URL=               # set these if the gate camera is not the classroom camera
ID_DATA_PATH=id_data         # violations.json + snapshots/
ID_API_TOKEN=                # optional shared secret, enter it under Setup & rules in the app
# Optional email to the student's contact (contacts.csv: student_id,email)
ID_EMAIL_ENABLED=0
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=               # Gmail: use a 16-character app password
SMTP_TLS=1
