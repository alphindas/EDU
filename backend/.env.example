# ---- core
EDUNEST_SECRET_KEY=change-me-32-bytes-minimum-random-string
EDUNEST_DATABASE_URL=sqlite:///./edunest.db
# PostgreSQL: pip install "psycopg[binary]" then
# EDUNEST_DATABASE_URL=postgresql+psycopg://edunest:edunest@localhost:5432/edunest
EDUNEST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EDUNEST_UPLOAD_DIR=./uploads
EDUNEST_MAX_UPLOAD_MB=8
EDUNEST_SEED_DEMO=0            # 1 = auto-create the demo school on startup (ephemeral hosting)

# ---- login
EDUNEST_OTP_PROVIDER=dev       # dev = fixed code 000000 logged to console; wire a real SMS gateway in app/otp.py

# ---- smart attendance (CerebroMark vision service)
EDUNEST_VISION_URL=http://localhost:5000
EDUNEST_VISION_TOKEN=

# ---- CHITTI 2.0 AI engine
# stub   = offline mode (no key, no network): starter topics, maths solver, English coach, library search
# openai = any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, local Ollama/vLLM ...)
# gemini = Google Gemini
EDUNEST_AI_PROVIDER=stub
EDUNEST_AI_API_KEY=
EDUNEST_AI_MODEL=              # e.g. gpt-4o-mini | gemini-1.5-flash | llama-3.1-8b-instant
EDUNEST_AI_BASE_URL=https://api.openai.com/v1   # change for Groq/OpenRouter/Ollama (http://localhost:11434/v1)
EDUNEST_AI_EMBED_MODEL=        # e.g. text-embedding-3-small (OpenAI-compatible only); empty = offline hash embeddings
EDUNEST_AI_DAILY_LIMIT=100     # AI calls per user per day
EDUNEST_AI_PER_MINUTE=12       # burst limit per user
EDUNEST_REQUIRE_AI_CONSENT=1   # students need parent consent before using CHITTI
EDUNEST_OCR_LANG=eng+hin+tel+mal+tam   # tesseract language packs used for photo doubts (missing ones are skipped)
